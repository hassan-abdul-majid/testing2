<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="seq_store_bill" model="ir.sequence">
        <field name="name">Store Bill</field>
        <field name="code">store.bill</field>
        <field name="prefix">BILL/</field>
        <field name="padding">5</field>
    </record>

    <!-- BILL LIST VIEW -->
    <record id="store_bill_list" model="ir.ui.view">
        <field name="name">store.bill.list</field>
        <field name="model">store.bill</field>
        <field name="arch" type="xml">
            <list string="Customer Bills">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="bill_date"/>
                <field name="total_amount"/>
                <field name="discount_amount"/>
                <field name="net_amount"/>
                <field name="received_amount"/>
                <field name="balance_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- BILL FORM VIEW -->
    <record id="store_bill_form" model="ir.ui.view">
        <field name="name">store.bill.form</field>
        <field name="model">store.bill</field>
        <field name="arch" type="xml">
            <form string="Customer Bill">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm Bill"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel Bill"
                            invisible="state != 'confirmed'"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,cancelled"
                           readonly="1"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="customer_name"
                               readonly="state != 'draft'"/>
                        <field name="bill_date"
                               readonly="state != 'draft'"/>
                        <field name="warehouse_id"
                               readonly="state != 'draft'"/>
                        <field name="stock_picking_id"
                               readonly="1"
                               invisible="not stock_picking_id"/>
                        <field name="stock_return_picking_id"
                               readonly="1"
                               invisible="not stock_return_picking_id"/>
                    </group>

                    <notebook>
                        <page string="Products">
                            <field name="line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"
                                           domain="[('is_storable', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
                                    <field name="quantity"/>
                                    <field name="available_qty" readonly="1"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"
                                           readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <group>
                        <group>
                            <field name="total_amount"/>
                            <field name="discount_amount"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="net_amount"/>
                            <field name="received_amount"
                                   readonly="state != 'draft'"/>
                            <field name="balance_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- BILL SEARCH VIEW -->
    <record id="store_bill_search" model="ir.ui.view">
        <field name="name">store.bill.search</field>
        <field name="model">store.bill</field>
        <field name="arch" type="xml">
            <search string="Search Bills">
                <field name="name"/>
                <field name="customer_name"/>
                <filter name="draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed"
                        string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="cancelled"
                        string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
            </search>
        </field>
    </record>

    <!-- BILL ACTION -->
    <record id="store_bill_action" model="ir.actions.act_window">
        <field name="name">Customer Bills</field>
        <field name="res_model">store.bill</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="store_bill_search"/>
    </record>

    <!-- MENUS -->
    <menuitem id="store_main_menu"
              name="My Store ERP"
              sequence="10"
              web_icon="store_billing,static/description/billing_module_logo.png"
              />

    <menuitem id="store_bills_menu"
              name="Customer Bills"
              parent="store_main_menu"
              action="store_bill_action"
              sequence="10"/>

</odoo>